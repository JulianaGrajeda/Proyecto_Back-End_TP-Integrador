<!-- encabezado -->
<header class="header-totem">

    <div class="icon">
        <img src="/img/logo.png" alt="Logo SKINCORE">
        <h1>SKINCORE</h1>
    </div>

    <p>Vista de administrador</p>
    
    <nav class="nav">
        <ul>
            <li><a href="/dashboard/principal">INICIO</a></li>
            <li><a href="/dashboard/crear">CREAR</a></li>
            <% if (typeof hideHeaderSearch === "undefined" || !hideHeaderSearch) { %>
                <li>
                    <form class="header-search" action="/dashboard/consultar" method="GET">
                        <input type="number" name="id" min="1" step="1" placeholder="Buscar por ID" aria-label="Buscar producto por ID" required>
                        <button type="submit">Buscar</button>
                    </form>
                </li>
            <% } %>
        </ul>
    </nav>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Alternar tema claro y oscuro" aria-pressed="false" title="Alternar tema claro y oscuro">
        <span class="theme-icon" aria-hidden="true">☾</span>
    </button>

</header>